# Copy to .env and fill in. Keep .env private: it holds the AI key.

# --- Address. DNS for this name must already point at this server (ports 80 and 443 open).
DOMAIN=quiz.example.sch.id

# --- First admin, created by install.sh (it prints a one-time password).
ADMIN_EMAIL=admin@example.sch.id
ADMIN_NAME=Admin

# --- Identity. Starting values; the admin can change them later on the Admin page.
QUIZ_SITE_NAME=Quiz
QUIZ_ORG=
QUIZ_COLOR_PRIMARY=#0f6b5f
QUIZ_COLOR_ACCENT=#f0b429

# --- Accounts. open/closed, and the role new sign-ups get (student/teacher). Also on the Admin page.
QUIZ_REGISTRATION=open
QUIZ_DEFAULT_ROLE=student

# --- Starter quizzes in the library: off, or on to load the files in app/seed/
QUIZ_SEED=off

# --- AI question writer (optional). Any OpenAI-compatible API. Leave QUIZ_AI_KEY empty to switch it off.
#   DeepSeek:   https://api.deepseek.com/v1      model e.g. deepseek-v4-flash
#   OpenAI:     https://api.openai.com/v1        model e.g. gpt-5-mini
#   OpenRouter: https://openrouter.ai/api/v1     model e.g. deepseek/deepseek-chat
QUIZ_AI_URL=https://api.deepseek.com/v1
QUIZ_AI_MODEL=deepseek-v4-flash
QUIZ_AI_KEY=

# --- Time zone for dates in reports and CSV files.
TZ=Asia/Jakarta

# --- Ports, only if 80/443 are taken (then put another proxy in front).
# HTTP_PORT=80
# HTTPS_PORT=443
